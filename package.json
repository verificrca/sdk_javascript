{
  "name": "@verificrca/sdk",
  "version": "0.1.0",
  "description": "SDK oficial Node.js pentru API-ul verificrca.ro: verificare RCA, ITP, rovinieta si copie conforma ARR dupa numar de inmatriculare sau serie de sasiu (VIN), plus gestionarea flotei si webhook-uri.",
  "keywords": [
    "verificrca",
    "verificare rca",
    "verificare itp",
    "verificare rovinieta",
    "verificare arr",
    "copie conforma arr",
    "rca api",
    "itp api",
    "rovinieta api",
    "asigurare auto",
    "asigurare rca",
    "aida",
    "baar",
    "rar",
    "cnair",
    "erovinieta",
    "numar inmatriculare",
    "serie sasiu",
    "vin",
    "vin lookup",
    "vehicle insurance",
    "vehicle inspection",
    "road tax",
    "romania",
    "flota auto",
    "fleet management",
    "monitorizare flota",
    "expirare rca",
    "expirare itp",
    "webhook",
    "sdk",
    "api client",
    "typescript",
    "effect"
  ],
  "homepage": "https://www.verificrca.ro/api-acces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verificrca/sdk_javascript.git"
  },
  "bugs": {
    "url": "https://github.com/verificrca/sdk_javascript/issues"
  },
  "author": "verificrca.ro <contact@verificrca.ro> (https://www.verificrca.ro)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "attw --pack .",
    "prepublishOnly": "pnpm typecheck && pnpm docs:check && pnpm test && pnpm build",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
